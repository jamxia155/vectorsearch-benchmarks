{
  "ads10m_lucene_hnsw": {
    "dataset": "ads_sourcing-10m",
    "common-params": {
      "numDocs": 10000000,
      "numQueriesToRun": 10000,
      "numWarmUpQueries": 5000,
      "flushFreq": 10000000,
      "topK": 1500,
      "efSearch": [1500, 2000, 2500, 3000, 4000],
