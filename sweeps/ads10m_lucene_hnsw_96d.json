      "forceMerge": 1,
      "enableTieredMerge": true,
      "enableIndexWriterInfoStream": false,
      "filterRejectRate": 0.0
    },
    "algorithms": {
      "LUCENE_HNSW": {
        "indexDirPath": "hnswIndex",
        "hnswMaxConn": [32, 64],
        "hnswBeamWidth": 128,
        "hnswMergeThreads": 32,
        "numIndexThreads": 32
      }
    }
  }
}
